# Copier ce fichier en `backend/.env` puis adapter (commande dans le README).
# Ne jamais committer `.env`. Les valeurs ci-dessous sont fictives.

DATABASE_URL="postgresql://objectiva:objectiva_dev@localhost:5432/objectiva?schema=public"
TEST_DATABASE_URL="postgresql://objectiva:objectiva_dev@localhost:5432/objectiva_test?schema=public"

# Clé de signature des jetons (64 caractères ou plus). Pour en générer une :
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="remplace-moi-par-une-longue-chaine-aleatoire-de-64-caracteres-minimum"

# Durée de vie d'une session (jours). La déconnexion la révoque immédiatement.
SESSION_DAYS=30

# Port de l'API (3100 pour éviter les conflits avec d'autres projets sur 3000).
PORT=3100

# Origines autorisées, séparées par des virgules :
# navigateur (ng serve) + application Android/iOS (Capacitor).
CORS_ORIGIN="http://localhost:4200,http://localhost,capacitor://localhost"
